# ===========================================
# ArdaNova Platform - Root Environment Config
# ===========================================
# Copy this file to .env and fill in your values
# All services reference this root .env file

# ===========================================
# Authentication
# ===========================================
AUTH_SECRET=your-auth-secret-min-32-chars-here
AUTH_URL=http://localhost:3000

# Google OAuth (Primary provider)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===========================================
# Database
# ===========================================
# Required by the API and web application. Keep this only in an ignored .env
# locally; configure it through the deployment secret manager in production.
DATABASE_URL=postgresql://postgres:password@localhost:5432/ardanova?sslmode=disable

# ===========================================
# Backend API
# ===========================================
API_URL=http://localhost:5147
# Required by the .NET API and must match the web application's server-side key.
# Never add a fallback key to appsettings.json.
API_KEY=
# Distinct privileged server-to-server key shared only by the frontend BFF and
# API. Use a random 32+ byte value and never expose it as NEXT_PUBLIC_*.
ADMIN_API_KEY=
# Shared server-side signing secret for binding frontend BFF requests to the
# authenticated actor. Use the exact same sealed 32+ byte value in both services.
ACTOR_ASSERTION_HMAC_KEY=

# ===========================================
# AZOA integration (safe default: disabled/simulated)
# ===========================================
# Economy mode. The API derives one word -- live / simulated / disabled -- from
# Azoa__Mode and Algorand__Provider, prints it as a startup banner, and publishes
# it as the "economy" field on GET /health and GET /ready:
#   live      Azoa__Mode=Live AND Algorand__Provider is Azoa or Legacy.
#             Value operations move real funds.
#   simulated a value rail is switched on but at least one leg is a deterministic
#             fake (sim: identifiers, or a no-chain Algorand provider). Nothing
#             here proves sponsorship, stake, settlement or payout works.
#   disabled  no value rail is switched on at all -- the default below.
# Production REFUSES anything but live: booting ASPNETCORE_ENVIRONMENT=Production
# with Azoa__Mode=Simulated or Algorand__Provider=Simulated throws at startup.
# There is deliberately no override flag.
#
# Live/provider-backed operation additionally requires an HTTPS base URL and
# separate server-only custody, value, and quest keys. Funding checkout stays disabled
# until a selected settlement node and reconciliation path are verified.
Azoa__BaseUrl=
# Onboarding/custody only: tenant:provision,wallet:manage,kyc:read,kyc:submit.
Azoa__CustodyApiKey=
# Value only: nft:mint for allocation/fungible mint; add no onboarding scopes.
Azoa__ValueApiKey=
# Quest only. Authoring requires dapp:develop and an API-key owner that holds
# Azoa's persisted dApp Developer role; do not reuse a value or custody key.
Azoa__QuestApiKey=
# Legacy non-Production migration fallback. Production ignores this setting.
Azoa__TenantApiKey=
Azoa__Mode=Simulated
Azoa__ChainType=Algorand
Azoa__TimeoutSeconds=30
# Operator opt-in for collecting payment. This flag ALONE never opens checkout;
# all four of these must hold, and /ready reports not_ready until they do:
#   1. Azoa__EnableFundingCheckout=true                (this flag)
#   2. Azoa__SelectedSettlementNodeId names the node that settles the collected
#      funds -- it is what selects the real settlement gateway over the disabled one
#   3. Azoa__SettlementAttestationExpiresAt is a FUTURE instant: the operator's
#      review of that node's dispatch and reconciliation capability. It expires so
#      a one-off sign-off cannot hold checkout open forever; unset means never
#      attested, which keeps checkout closed
#   4. the funding-settlement readiness check agrees at request time
Azoa__EnableFundingCheckout=false
Azoa__SelectedSettlementNodeId=
# ISO-8601 instant, for example 2026-12-31T00:00:00Z. A malformed value is a
# startup failure rather than a silent downgrade.
Azoa__SettlementAttestationExpiresAt=
Azoa__EnableSettlementOutboxWorker=false
Azoa__SettlementOutboxBatchSize=10
Azoa__SettlementOutboxIntervalSeconds=15
Azoa__EnableCustodialAccounts=false
# Production activation order -- do not set this to true until BOTH steps below
# are done, or this app's own /ready goes not_ready (not just the custodial
# sub-check):
#   1. On the AZOA node's OWN Railway service (not this one), all three of its
#      readiness legs must be live -- each is independent and each names itself
#      by exact key when missing:
#        - Custody:  CustodialAccounts__CustodyMode=Platform, plus a
#          boot-validated AZOA__WalletEncryptionKey (>=32 chars).
#        - Chain:    Blockchain__Mode not Simulated.
#        - KYC:      Kyc__Identomat__CompanyKey, Kyc__Identomat__ConfigId
#          (both issued by an actual Identomat vendor account -- there is no
#          substitute value), and Kyc__Identomat__CallbackApiKey (>=32 chars,
#          minted by the AZOA operator, not Identomat, and registered in
#          Identomat's dashboard as the inbound-webhook shared secret).
#      See the AZOA repo's docs/NODE-HOST.md sections 8.2 and 8.5.
#   2. Only once step 1 holds does registering a tenant and minting its API key
#      (per docs/NODE-HOST.md section 8.6, "Onboard the first tenant") mean
#      anything: the key becomes Azoa__CustodyApiKey above and its tenant GUID
#      becomes Azoa__TenantId below. Set both together with this flag, from
#      that one onboarding call -- never this flag alone.
# Whichever leg is still missing shows up, by name, in AZOA's own
# GET /api/tenant/custodial-accounts/capabilities and is republished verbatim
# by this app's GET /ready as checks.azoa.custodialAccountsUnavailableReason.
# GUID assigned by AZOA when the tenant is provisioned. Required, and
# validated as a GUID, whenever Azoa__EnableCustodialAccounts=true.
Azoa__TenantId=
# Which implementation backs the Algorand port: Azoa (via the shared node),
# Legacy (direct custodial signer), or Simulated (no chain I/O). Simulated is
# refused in Production -- see the economy-mode note at the top of this section.
Algorand__Provider=Simulated
Algorand__RequireCredentialOperations=false
Algorand__AllowLegacyCustodialSignerInProduction=false
# Optional browser-safe, read-only SDK origin. Never put a tenant key in a
# NEXT_PUBLIC variable. Leave unset while the browser SDK surfaces are dormant.
# NEXT_PUBLIC_AZOA_BASE_URL=https://public-azoa-api.example.com

# ASP.NET Core Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# ===========================================
# File Storage (S3-Compatible)
# ===========================================
# Provider: S3, Azure, Local (default: Local for development)
STORAGE_PROVIDER=Local

# S3 Configuration (AWS S3, MinIO, Cloudflare R2, DigitalOcean Spaces)
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_BUCKET_NAME=ardanova-files
S3_REGION=us-east-1
# Optional: Custom endpoint for S3-compatible services (MinIO, R2, etc.)
# S3_SERVICE_URL=http://localhost:9000
# S3_USE_PATH_STYLE=true

# Local Storage (for development)
LOCAL_STORAGE_PATH=./uploads
LOCAL_STORAGE_BASE_URL=http://localhost:8080/files

# ===========================================
# AI Orchestrator Service
# ===========================================
ANTHROPIC_API_KEY=your-anthropic-api-key
MCP_SERVER_URL=http://localhost:8080

# ===========================================
# Algorand Blockchain (Future)
# ===========================================
# ALGOD_ADDRESS=https://testnet-api.algonode.cloud
# ALGOD_TOKEN=
# INDEXER_ADDRESS=https://testnet-idx.algonode.cloud
# INDEXER_TOKEN=

# ===========================================
# Feed projector (SR-03, .NET API): writes the feed's system cards
# ===========================================
# OFF unless set true, in every environment (Development too: this file's
# DATABASE_URL may be a shared database, and the first cycle deletes). A
# malformed value leaves it OFF and logs Critical; the API still starts.
Feed__Projector__Enabled=

# ===========================================
# Docker/Production Overrides
# ===========================================
NODE_ENV=development

# Note: Replace all placeholder values with your actual configuration.
# For production, use strong secrets and enable SSL.
